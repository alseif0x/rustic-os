{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusticos:services:v1:files.read",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "workspace": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        },
        "resource": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        },
        "expected_version": {
          "oneOf": [
            {
              "$ref": "urn:rusticos:services:v1:types#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "workspace",
        "resource",
        "expected_version",
        "offset",
        "length"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "workspace": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        },
        "resource": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        },
        "version": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/bytes"
        },
        "range_sha256": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/sha256"
        },
        "eof": {
          "type": "boolean"
        },
        "retry_epoch": {
          "$ref": "urn:rusticos:services:v1:types#/$defs/token"
        }
      },
      "required": [
        "workspace",
        "resource",
        "version",
        "size",
        "offset",
        "data",
        "range_sha256",
        "eof",
        "retry_epoch"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "method": {
          "const": "files.read"
        },
        "params": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "version",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "method": {
              "const": "files.read"
            },
            "result": {
              "$ref": "#/$defs/output"
            }
          },
          "required": [
            "version",
            "method",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "method": {
              "const": "files.read"
            },
            "error": {
              "$ref": "urn:rusticos:services:v1:types#/$defs/error"
            }
          },
          "required": [
            "version",
            "method",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
